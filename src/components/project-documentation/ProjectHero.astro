---
interface Props {
  title: string;
  description: string;
  logo?: string;
  github?: string;
  category: "business" | "education";
  showBackLink?: boolean;
}

const { title, description, logo, github, category, showBackLink = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}${path.replace(/^\//, "")}`;
---

<section class="flex min-w-0 flex-col gap-6 sm:gap-8">
  <div class="flex max-w-3xl flex-col gap-4 sm:gap-5">
    {showBackLink && <a href={`${base}projects/`} class="flex w-fit items-center gap-2 rounded-lg border border-gray-300 px-3 py-2 text-sm font-semibold text-gray-950 no-underline transition-colors hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fuchsia-700 dark:border-neutral-800 dark:text-white dark:hover:bg-gray-900"><svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>Volver a proyectos</a>}
    <div class="flex flex-wrap items-center gap-3 text-sm font-medium text-gray-600 dark:text-gray-400">
      <span>{category === "education" ? "Proyecto educativo" : "Proyecto empresarial"}</span><span aria-hidden="true">•</span><span>Caso de estudio</span>
    </div>
    <div class="flex flex-col gap-3">
      <div class="flex items-center gap-4 sm:gap-5">
        {logo && <img src={asset(logo)} alt={`Logo de ${title}`} class="size-16 shrink-0 rounded-xl border border-gray-300 bg-white p-2 object-contain sm:size-20 dark:border-neutral-800" width="80" height="80" />}
        <h1 class="text-3xl font-bold tracking-tight text-gray-950 sm:text-4xl lg:text-5xl dark:text-white">{title}</h1>
      </div>
      {github && <a href={github} target="_blank" rel="noreferrer" class="flex w-fit items-center gap-2 rounded-md border border-gray-300 px-3 py-2 text-sm font-semibold text-gray-950 no-underline transition-colors hover:border-gray-400 hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700 dark:border-neutral-800 dark:text-white dark:hover:bg-gray-900"><svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .7a11.3 11.3 0 0 0-3.57 22.02c.56.1.77-.24.77-.54v-2.1c-3.14.68-3.8-1.33-3.8-1.33-.5-1.3-1.25-1.65-1.25-1.65-1.03-.7.08-.7.08-.7 1.13.08 1.73 1.16 1.73 1.16 1.01 1.72 2.64 1.22 3.29.93.1-.73.4-1.22.72-1.5-2.5-.28-5.13-1.25-5.13-5.57 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.75 10.75 0 0 1 5.64 0c2.15-1.45 3.1-1.15 3.1-1.15.61 1.55.23 2.7.11 2.98.72.79 1.16 1.8 1.16 3.02 0 4.33-2.64 5.28-5.15 5.56.4.35.76 1.02.76 2.06v3.06c0 .3.2.65.78.54A11.3 11.3 0 0 0 12 .7Z" /></svg>Ver en GitHub</a>}
      <p class="max-w-2xl text-base leading-6 text-gray-600 sm:text-lg dark:text-gray-400">{description}</p>
    </div>
  </div>
</section>
