---
interface Project {
  name: string;
  shortDescription: string;
  logo?: string;
  technologies: string[];
  github?: string;
  hasDocumentation: boolean;
  documentationUrl?: string;
}

interface Props {
  project: Project;
}

const { name, shortDescription, logo, technologies, github, hasDocumentation, documentationUrl } = Astro.props.project;
const logoUrl = logo ? `${import.meta.env.BASE_URL}${logo.replace(/^\//, "")}` : undefined;
const documentationHref = documentationUrl
  ? `${import.meta.env.BASE_URL}${documentationUrl.replace(/^\//, "")}/`
  : undefined;
---

<article
  class="reveal-card relative flex h-full flex-col items-stretch rounded-md bg-white p-3 duration-700 ease-out group w-full dark:bg-gray-950/30"
>
  <span
    class="absolute inset-0 z-20 block size-full duration-700 ease-in-out bg-transparent border border-transparent group-hover:border-gray-300 dark:group-hover:border-neutral-800 rounded-md group-hover:bg-white dark:group-hover:bg-gray-950/30"
  ></span>
  <span
    class="absolute inset-0 z-10 block w-full h-full duration-700 ease-in-out border rounded-md border-gray-300 dark:border-neutral-800 group-hover:shadow-md"
  ></span>
  <span
    class="relative z-30 flex h-full flex-col duration-700 ease-in-out"
  >
    <span class="flex aspect-[16/9] w-full items-center justify-center overflow-hidden rounded-lg border border-gray-200 bg-white p-6 dark:border-neutral-800" aria-label={logoUrl ? `Logo de ${name}` : `Proyecto ${name} sin logo disponible`}>
      {logoUrl ? (
        <img loading="lazy" src={logoUrl} class="size-full object-contain" alt={`Logo de ${name}`} width={200} height={200} />
      ) : (
        <span class="flex size-20 items-center justify-center rounded-2xl bg-gray-100 text-2xl font-bold text-gray-500 dark:bg-neutral-800 dark:text-gray-300" aria-hidden="true">{name.slice(0, 2).toUpperCase()}</span>
      )}
    </span>
    <span class="flex flex-1 flex-col w-full px-1 mt-5 mb-1 sm:mt-3">
      <span
        class="flex items-center mb-0 text-base font-semibold tracking-tight text-gray-950 dark:text-gray-100"
      >
        <span>{name}</span>
        <svg
          class="group-hover:translate-x-0 group-hover:translate-y-0 -rotate-45 translate-y-1 -translate-x-1 w-2.5 h-2.5 stroke-current ml-1 transition-all ease-in-out duration-200 transform"
          viewBox="0 0 13 15"
          version="1.1"
          xmlns="http://www.w3.org/2000/svg"
          xmlns:xlink="http://www.w3.org/1999/xlink"
          ><g
            stroke="none"
            stroke-width="1"
            fill="none"
            fill-rule="evenodd"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><g
              id="svg"
              transform="translate(0.666667, 2.333333)"
              stroke="currentColor"
              stroke-width="2.4"
              ><g
                ><polyline
                  class="transition-all duration-200 ease-out opacity-0 delay-0 group-hover:opacity-100"
                  points="5.33333333 0 10.8333333 5.5 5.33333333 11"
                ></polyline><line
                  class="transition-all duration-200 ease-out transform -translate-x-1 opacity-0 group-hover:translate-x-0 group-hover:opacity-100 group-hover:ml-0"
                  x1="10.8333333"
                  y1="5.5"
                  x2="0.833333333"
                  y2="5.16666667"></line></g
              ></g
            ></g
          ></svg
        >
      </span>
      <span class="text-sm text-gray-600 dark:text-gray-400 block">{shortDescription}</span>
      <span class="mt-3 flex flex-wrap gap-1">
        {technologies.map((technology) => <span class="text-xs text-blue-700 dark:text-blue-400">{technology}</span>)}
      </span>
      <span class="mt-4 flex flex-1 flex-col items-start gap-3">
        {github && <a href={github} target="_blank" rel="noreferrer" class="max-w-full truncate text-sm font-medium text-gray-600 transition-colors hover:text-blue-700 dark:text-gray-400 dark:hover:text-blue-400">GitHub: <span class="underline underline-offset-2">{github}</span></a>}
        {hasDocumentation && documentationHref && (
          <a href={documentationHref} class="action-button mt-auto self-end">Ver más información</a>
        )}
      </span>
    </span>
  </span>
</article>
