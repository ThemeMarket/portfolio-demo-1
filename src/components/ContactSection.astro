---
import Card from "./Card.astro";
---

<section id="contact" class="flex scroll-mt-24 flex-col gap-6">
  <h2 class="text-2xl font-bold text-gray-950 dark:text-white md:text-4xl">
    Contacto y redes sociales
  </h2>
  <Card className="p-6">
    <ul class="grid grid-cols-1 gap-x-10 gap-y-6 text-gray-700 dark:text-gray-300 md:grid-cols-2">
      <li class="flex items-center gap-4">
        <svg aria-hidden="true" class="size-5 shrink-0 text-fuchsia-600 dark:text-fuchsia-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        <div><p class="font-semibold text-gray-900 dark:text-white">Correo</p><a href="mailto:waltercastil2019@outlook.com" class="break-all transition-colors hover:text-fuchsia-700 dark:hover:text-fuchsia-300">waltercastil2019@outlook.com</a></div>
      </li>
      <li class="flex items-center gap-4">
        <svg aria-hidden="true" class="size-5 shrink-0 text-fuchsia-600 dark:text-fuchsia-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M16 22v-4a4 4 0 0 0-4-4c-3 0-5-2-5-5a5 5 0 0 1 1.3-3.4A4 4 0 0 1 9 2s1.6 0 3 1.2C13.4 2 15 2 15 2a4 4 0 0 1 .7 3.6A5 5 0 0 1 17 9c0 3-2 5-5 5"/><path d="M8 18c-3 1-3-2-4-2"/></svg>
        <div><p class="font-semibold text-gray-900 dark:text-white">GitHub</p><a href="https://github.com/WalterJoelCode" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-fuchsia-700 dark:hover:text-fuchsia-300">github.com/WalterJoelCode</a></div>
      </li>
      <li class="flex items-center gap-4">
        <svg aria-hidden="true" class="size-5 shrink-0 text-fuchsia-600 dark:text-fuchsia-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 11v6M8 8v.01M12 17v-6M12 14a3 3 0 0 1 6 0v3"/></svg>
        <div><p class="font-semibold text-gray-900 dark:text-white">LinkedIn</p><a href="https://www.linkedin.com/in/waltercorea/" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-fuchsia-700 dark:hover:text-fuchsia-300">linkedin.com/in/waltercorea</a></div>
      </li>
      <li class="flex items-center gap-4">
        <svg aria-hidden="true" class="size-5 shrink-0 text-fuchsia-600 dark:text-fuchsia-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><circle cx="9" cy="8" r="1" fill="currentColor"/><path d="M9 11v6M12 11v6M12 14a3 3 0 0 1 6 0v3"/></svg>
        <div><p class="font-semibold text-gray-900 dark:text-white">ORCID</p><a href="https://orcid.org/0009-0000-6492-9108" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-fuchsia-700 dark:hover:text-fuchsia-300">0009-0000-6492-9108</a></div>
      </li>
    </ul>
  </Card>
</section>
