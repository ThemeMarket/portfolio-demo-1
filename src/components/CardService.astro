---
import Card from "./Card.astro";

interface Service {
  id: number;
  title: string;
  price: number;
  benefits: string[];
}

interface Props {
  service: Service;
}

const { id, title, benefits, price } = Astro.props.service;
---

<Card className="card-service h-fit">
  <div class="flex flex-col gap-2">
    <h3 class="text-xl text-gray-950 dark:text-gray-100 font-semibold mb-4">
      {title}
    </h3>
    <p class="font-bold text-2xl text-gray-950 dark:text-white">${price}</p>
    <ul class="text-gray-600 dark:text-gray-400 list-inside list-disc mb-4">
      {benefits.map((benefit) => <li>{benefit}</li>)}
    </ul>
  </div>
  <button
    data-service-id={id}
    class="hireServiceButton action-button w-full"
  >
    Get Started
  </button>
</Card>
