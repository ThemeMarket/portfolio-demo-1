---
import Layout from "../layouts/Layout.astro";
import { PROJECTS } from "../data/projects/catalog";
import Project from "../components/Project.astro";

export const prerender = true;
---

<Layout>
  <section class="flex flex-col gap-2">
    <h1
      class="font-bold text-2xl sm:text-3xl lg:text-4xl text-gray-950 dark:text-white"
    >
      Proyectos
    </h1>
    <p
      class="text-base md:text-lg sm:w-3/4 text-gray-600 dark:text-gray-400 text-pretty"
    >
      Una selección de soluciones orientadas a automatizar procesos, mejorar la
      operación y ofrecer experiencias web claras.
    </p>
  </section>
  <section
    class="grid w-full grid-cols-1 gap-6 mx-auto sm:grid-cols-2 lg:grid-cols-3"
  >
    {PROJECTS.map((project) => <Project project={project} />)}
  </section>
</Layout>
